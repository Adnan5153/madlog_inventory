# Vercel deployment ignore — exclude dev artefacts from the deploy bundle.
# The build runs composer install (so vendor/ IS shipped) and npm run build
# (so node_modules ends up in the bundled output but not as a deployable).
# This file only affects what gets uploaded alongside the compiled output.

# Local env files — secrets must live in Vercel env vars, not the repo.
/.env
/.env.*
/.env.example

# Tests, dev tooling, IDE, OS junk
/tests
/.phpunit.cache
/.phpunit.result.cache
/.idea
/.vscode
/.editorconfig
/.gitattributes
/.gitignore
/.git
/.github

# Documentation that doesn't belong on the server
/README.md
/CHANGELOG.md
/LICENSE
/docs

# Static marketing artefacts — not served by this Vercel project
/index.html
/index.original.html
/scripts

# Build config that's only used locally (not at runtime)
/vite.config.js
/postcss.config.js
/tailwind.config.js
/phpunit.xml
/phpstan.neon